\end{figure}

\subsection{Numerical Integration Methods}
The continuous demographic flows are approximated using the Forward Euler numerical integration method with an annual discrete step size of $\Delta t = 1\text{ yr}$. For any cohort state variable governed by $\frac{dY}{dt} = \text{Inflow} - \text{Outflow}$, the value at the subsequent annual increment is:
\begin{equation}
Y(t + \Delta t) = Y(t) + \Delta t \left(\text{Inflow}(t) - \text{Outflow}(t)\right)
\end{equation}
Because biological cohorts advance between single-year age brackets annually, an integer time step of $\Delta t = 1$ ensures individual cohorts progress systematically across successive stages without numerical dispersion.

\subsection{Captive Subpopulation Dynamics}
Captive condor pairs operating under double-clutching achieve a pair fecundity rate of $f_{\text{cap}} = 1.8\text{ yr}^{-1}$ (or $0.9\text{ yr}^{-1}$ without double-clutching), corresponding to an individual adult reproduction rate of $m_{\text{cap}} = 0.9\text{ yr}^{-1}$ assuming an equal 1:1 sex ratio. Captive condors reach reproductive maturity at age 7 ($Y_{A,\text{cap}}$).

The balance equations governing captive age cohorts are:
\begin{align}
\frac{dY_{0,\text{cap}}}{dt} &= m_{\text{cap}} Y_{A,\text{cap}}(t) - Y_{0,\text{cap}}(t) \\
\frac{dY_{1,\text{cap}}}{dt} &= (1 - d_0) Y_{0,\text{cap}}(t) - Y_{1,\text{cap}}(t) \\
\frac{dY_{2,\text{cap}}}{dt} &= (1 - r(t))(1 - d_1) Y_{1,\text{cap}}(t) - Y_{2,\text{cap}}(t) \\
\frac{dY_{k,\text{cap}}}{dt} &= (1 - d_I) Y_{k-1,\text{cap}}(t) - Y_{k,\text{cap}}(t) \quad \text{for } k = 3, 4, 5, 6 \\
\frac{dY_{A,\text{cap}}}{dt} &= (1 - d_I) Y_{6,\text{cap}}(t) - d_A Y_{A,\text{cap}}(t)
\end{align}

The release fraction $r(t)$ dictates juvenile reintroduction into the wild. By default, $80\%$ of 1-year-old captive juveniles are transferred each year. If total captive occupancy exceeds the facility carrying capacity of 150 birds, all surviving Year 1 juveniles are released:
\begin{equation}
r(t) = \begin{cases} 
0.80, & \text{if } N_{\text{cap}}(t) \le 150 \\
1.00, & \text{if } N_{\text{cap}}(t) > 150 
\end{cases}
\end{equation}
where total captive population is $N_{\text{cap}}(t) = \sum_{k=0}^{6} Y_{k,\text{cap}}(t) + Y_{A,\text{cap}}(t)$.

\subsection{Wild Subpopulation Dynamics and Reintroduction}
Wild condors exhibit a lower base fecundity of $f_{\text{wild}} = 0.3729\text{ yr}^{-1}$ per pair ($m_{\text{wild}} = 0.18645\text{ yr}^{-1}$ per adult) and attain reproductive maturity at age 8 ($Y_{A,\text{wild}}$). Wild reproduction is density-dependent, constrained by an environmental carrying capacity of $K_{\text{wild}} = 400$ birds:
\begin{align}
\frac{dY_{0,\text{wild}}}{dt} &= m_{\text{wild}} Y_{A,\text{wild}}(t)\left(1 - \frac{N_{\text{wild}}(t)}{400}\right) - Y_{0,\text{wild}}(t) \\
\frac{dY_{1,\text{wild}}}{dt} &= (1 - d_0) Y_{0,\text{wild}}(t) - Y_{1,\text{wild}}(t)
\end{align}
where $N_{\text{wild}}(t) = \sum_{k=0}^{7} Y_{k,\text{wild}}(t) + Y_{A,\text{wild}}(t)$.

The wild 2-year-old cohort ($Y_{2,\text{wild}}$) receives both native Year 1 survivors and translocated captive juveniles:
\begin{align}
\frac{dY_{2,\text{wild}}}{dt} &= (1 - d_1) Y_{1,\text{wild}}(t) + r(t)(1 - d_1) Y_{1,\text{cap}}(t) - Y_{2,\text{wild}}(t) \\
\frac{dY_{k,\text{wild}}}{dt} &= (1 - d_I) Y_{k-1,\text{wild}}(t) - Y_{k,\text{wild}}(t) \quad \text{for } k = 3, 4, 5, 6, 7 \\
\frac{dY_{A,\text{wild}}}{dt} &= (1 - d_I) Y_{7,\text{wild}}(t) - d_A Y_{A,\text{wild}}(t)
\end{align}

